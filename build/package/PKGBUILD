# Maintainer: sudo-megas <sudo-megas@users.noreply.github.com>

pkgname=indium
pkgver=1.0.0
# The one place the package revision is written. make-deb.sh reads its Debian revision
# out of this line, verify.sh builds both default artefact paths from it, and the release
# workflow derives the tag it will accept from it — so the two packages cannot disagree
# about which build they are, and a tag cannot be pushed over a tree that means a
# different one. `2` is P10: the source changed, and the version did not.
pkgrel=3
pkgdesc="An archive manager for Linux on Wayland where the metadata is the main event."
arch=('x86_64')
url="https://github.com/sudo-megas/INDIUM"
license=('GPL-3.0-only' 'OFL-1.1')

# CORE §2's system-library table names what the compositor session already provides. A
# package must still say so, or it installs a program that cannot open a window.
#
#   libarchive     the one direct link that does format work: DT_NEEDED of the binary is
#                  exactly libarchive.so.13, libgcc_s.so.1, libm.so.6, libc.so.6.
#   wayland        libwayland-client.so.0 and libwayland-egl.so.1
#   libxkbcommon   libxkbcommon.so.0
#   libglvnd       libEGL.so.1
#   glibc          libc.so.6, libm.so.6
#   libgcc         libgcc_s.so.1
#
# The middle three appear in *no* `ldd` output: winit and glutin `dlopen` them by soname
# at runtime, so the linker never records them and only `strings target/release/indium`
# finds them. Missing, they are a failure at first frame rather than at install.
#
# Everything else `ldd` prints — libcrypto, libzstd, liblz4, libbz2, libz, liblzma,
# libxml2, libicuuc, libacl, libbrotli*, libstdc++ — is libarchive's own DT_NEEDED
# closure and belongs to libarchive's packaging, not here.
#
# `libgcc`, not `gcc-libs`: `pacman -Qoq /usr/lib/libgcc_s.so.1` answers `libgcc` on
# current Arch, which split the old gcc-libs into per-library packages.
depends=('libarchive' 'wayland' 'libxkbcommon' 'libglvnd' 'glibc' 'libgcc')
makedepends=('git' 'rust')

# Both of these are in the stock `OPTIONS=` line of /etc/makepkg.conf:101, so switching
# them off has to be explicit.
#
# !debug — `debug` splits an indium-debug package out of the debug symbols. Cargo.toml's
#   [profile.release] sets `strip = true`, so rustc strips at link time and there are no
#   symbols left to split; the package would ship empty.
#
#   Turning it off has a second effect that is easy to miss and was missed here until
#   makepkg said so: rust.sh adds `--remap-path-prefix` *only* when `debug` is on, and
#   those paths are panic locations rather than debug information, so `strip` never
#   touches them. build() therefore does the remap itself. Do not delete that line while
#   this option is set.
#
# !lto — Cargo.toml already sets `lto = true`, and makepkg's option cannot reach it:
#   /usr/share/makepkg/buildenv/lto.sh:35-37 appends LTOFLAGS to CFLAGS, CXXFLAGS and
#   LDFLAGS only, three variables cargo never reads.
options=('!debug' '!lto')

# The tag is the pin. GitHub's autogenerated tag tarballs are not byte-stable, so a
# sha256sum written against one is a checksum of an artefact that may be regenerated
# differently; and the checksum of a tag cannot be written into a commit that predates
# that tag. A git source resolved at `#tag=v1.0` names the content exactly, which is what
# a checksum was for. Hence SKIP — there is nothing left for it to prove.
source=("$pkgname::git+$url.git#tag=v1.0")
sha256sums=('SKIP')

# No pkgver() on purpose. A VCS source usually carries one, but it exists to track a
# moving branch; this source is nailed to a tag, and a pkgver() would only rewrite 1.0.0
# into a description of the same commit.

prepare() {
  cd "$pkgname"
  # Populate the cargo cache while the network is still expected. --locked refuses to
  # touch Cargo.lock, so what gets fetched is what the tag recorded.
  cargo fetch --locked
}

build() {
  cd "$pkgname"

  # Remap the build paths by hand, because `!debug` above is what turns off the hook that
  # would otherwise do it: /usr/share/makepkg/buildenv/rust.sh appends
  # `--remap-path-prefix=$srcdir=...` to RUSTFLAGS, and only when the `debug` option is on.
  # Without this the shipped binary carries the builder's own home directory — makepkg's
  # own check catches one half of it ("Package contains reference to $srcdir", from a
  # generated glutin_egl_sys binding), and 427 references to the cargo registry are the
  # other half, which nothing warns about. Neither is debug information: they are panic
  # locations, so `strip = true` does not remove them and there is nothing to be gained by
  # shipping them. Exported rather than passed, so check()'s `cargo test` sees the same
  # flags and does not rebuild the world to run the tests.
  export RUSTFLAGS="$RUSTFLAGS --remap-path-prefix=$srcdir=/usr/src/debug/$pkgname"
  export RUSTFLAGS="$RUSTFLAGS --remap-path-prefix=${CARGO_HOME:-$HOME/.cargo}/registry=/usr/src/debug/$pkgname/registry"

  # --frozen is --locked --offline: after prepare(), nothing further is downloaded, and a
  # Cargo.lock that disagrees with Cargo.toml is an error rather than a silent update.
  cargo build --release --frozen
}

check() {
  cd "$pkgname"
  cargo test --frozen

  # CORE §2's gate: "No GTK. No Qt. No KF6. No portal." Running it here, and not only by
  # hand before a release, means a package can never be produced from a binary that grew
  # a toolkit — the build fails before there is anything to install.
  ./build/check-deps.sh
}

package() {
  cd "$pkgname"

  # The desktop entry and the ten hicolor icon sizes, from the one script that also
  # serves the .deb and the dev machine. The size list lives there and nowhere else.
  ./build/install-payload.sh "$pkgdir/usr" target/release/indium

  # CORE §8: GPL-3.0-only in LICENSE, the font's OFL-1.1 alongside it. /usr/share/
  # licenses/spdx/ carries GPL-3.0-only.txt but has no OFL-1.1, so the font licence has
  # no system copy to point at and ships with the package.
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 LICENSES/OFL-1.1.txt "$pkgdir/usr/share/licenses/$pkgname/OFL-1.1.txt"
}

# No .install file, deliberately. Arch already ships the two hooks such a file would
# call, and both fire on paths this package writes:
#
#   /usr/share/libalpm/hooks/update-desktop-database.hook  Target = usr/share/applications/*.desktop
#   /usr/share/libalpm/hooks/gtk-update-icon-cache.hook    Target = usr/share/icons/*/
#
# An .install running update-desktop-database or gtk-update-icon-cache by hand would run
# them a second time, on every install, upgrade and removal, to no effect. The dev-machine
# script calls them itself only because ~/.local/share has no hooks watching it.
#
# Nothing here overrides the package format: PKGEXT='.pkg.tar.zst' is already the stock
# value at /etc/makepkg.conf:159, so the extension CORE §8 names is the one makepkg
# produces on an untouched machine.
