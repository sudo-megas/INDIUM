/target
.claude/settings.local.json

# The two largest icon masters. Everything the program and the installer use is
# committed (16 through 1024); 2048 and 4096 are 21 MB between them, exist only as
# sources for future downscales, and are the maker's to keep locally. Remove these two
# lines to track them.
/build/icons/indium-2048.png
/build/icons/indium-4096.png

# Release artefacts. `indium-0.4-x86_64.tar.gz` was committed at the head of P5 and
# `indium-0.5-x86_64.tar.gz` was one `git add -A` from joining it. A release tarball
# belongs on the release page, not in history where it sits forever. P6 §9.
/indium-*-x86_64.tar.gz

# makepkg writes its working directories and the finished package beside the PKGBUILD,
# which is why the PKGBUILD has a directory of its own. Nothing here is a source.
/build/package/src/
/build/package/pkg/
/build/package/out/
/build/package/*.pkg.tar.zst

# The release tarball, when it is downloaded here to be tested against. The rule above
# names the root copy; PXX pulled `v2.1`'s three artefacts into this directory to run the
# suite against what shipped, and the tarball was the one of the three no pattern caught.
# A near-miss of exactly the kind P6 §9 exists for.
/build/package/*.tar.gz
